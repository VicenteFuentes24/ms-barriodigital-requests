SERVER_PORT=8081

DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

JPA_DDL_AUTO=update

# RabbitMQ local; usar rabbitmq como host dentro de la red Docker.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Optional comma-separated host:port list. When nonempty, takes precedence over host/port.
# AWS: 10.0.1.62:5672,10.0.2.151:5672 (private IPs, never public endpoints).
RABBITMQ_ADDRESSES=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=barriodigital
RABBITMQ_CONNECTION_TIMEOUT_MS=3000
RABBITMQ_CONFIRM_TIMEOUT_MS=5000
RABBITMQ_HEALTH_ENABLED=false

# Enable only after manually reviewing/applying sql/kafka/V001__requests_kafka_outbox.sql.
# Before activation set JPA_DDL_AUTO=validate. No schema migration is automatic.
KAFKA_PUBLISHER_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_REQUESTS_TOPIC=bd.requests.events.v1
CATALOG_SERVICE_URL=http://localhost:8082
KAFKA_CATALOG_TIMEOUT_MS=2000
KAFKA_OUTBOX_WORKER_ENABLED=true
KAFKA_OUTBOX_POLL_MS=1000
KAFKA_OUTBOX_BATCH_SIZE=10
KAFKA_OUTBOX_RETRY_INITIAL_MS=2000
KAFKA_OUTBOX_RETRY_MAX_MS=60000
KAFKA_SEND_TIMEOUT_MS=20000
KAFKA_DELIVERY_TIMEOUT_MS=15000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_MAX_BLOCK_MS=10000
KAFKA_PRODUCER_BACKOFF_MS=500
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
